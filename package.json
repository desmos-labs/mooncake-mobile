{
  "name": "butter",
  "version": "1.4.2",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "postinstall": "patch-package && rn-nodeify -y --install stream,crypto,fs,path --hack",
    "deploy:androidInternal": "fastlane android deploy_to_internal_testing",
    "deploy:iosInternal": "fastlane ios build && fastlane ios deploy",
    "deploy:copyDevEnv": "cp .env.dev.sample .env",
    "detox:build-ios": "detox build -c ios.sim.release",
    "detox:test-ios": "detox test -c ios.sim.release",
    "prebuild": "source ./.prebuild.env && yarn eas-build-pre-install && npx expo prebuild --clean",
    "android:generateGogleServices": "printf $ANDROID_GOOGLE_SERVICES_BASE64 | base64 --decode > ./google-services.json",
    "ios:generateGogleServices": "printf $IOS_GOOGLE_SERVICES_BASE64 | base64 --decode > ./GoogleService-Info.plist",
    "eas-build-pre-install": "yarn android:generateGogleServices && yarn ios:generateGogleServices",
    "check-translations": "i18n-unused display-unused",
    "find-deadcode": "knip"
  },
