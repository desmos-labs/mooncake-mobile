    "react": "18.2.0",
    "react-content-loader": "^6.2.0",
    "react-i18next": "^11.17.2",
    "react-native": "0.71.1",
    "react-native-aes-crypto": "^2.1.1",
    "react-native-animated-pagination-dots": "^0.1.73",
