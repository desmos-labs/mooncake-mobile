{
  "name": "desmosflagship",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "prepare": "husky install",
    "prestorybook": "rnstl",
    "use:main": "cp index.main.js index.js",
    "use:storybook": "cp index.storybook.js index.js && yarn prestorybook",
    "postinstall": "patch-package && rn-nodeify --install stream,crypto,fs,path --hack"
  },
  "dependencies": {
    "@apollo/client": "^3.6.9",
    "@cosmjs/ledger-amino": "^0.28.10",
    "@desmoslabs/desmjs": "^3.0.1",
    "@desmoslabs/desmjs-types": "^3.0.1",
    "@habx/apollo-multi-endpoint-link": "^2.7.0",
    "@ledgerhq/react-native-hw-transport-ble": "^6.27.1",
    "@react-native-clipboard/clipboard": "^1.10.0",
    "@react-native-masked-view/masked-view": "^0.2.6",
    "@react-navigation/native": "^6.0.10",
    "@react-navigation/stack": "^6.2.1",
    "asyncstorage-down": "^4.2.0",
    "big.js": "^6.2.0",
    "date-fns": "^2.28.0",
    "formik": "^2.2.9",
    "graphql": "^16.5.0",
    "i18next": "^21.8.10",
    "numeral": "^2.0.6",
    "patch-package": "^6.4.7",
    "path-browserify": "^0.0.0",
    "react": "18.0.0",
    "react-i18next": "^11.17.2",
    "react-native": "0.69.0",
    "react-native-ble-plx": "^2.0.3",
    "react-native-bluetooth-state-manager": "^1.3.3",
    "react-native-config": "^1.4.6",
    "react-native-crypto": "^2.2.0",
    "react-native-gesture-handler": "^2.5.0",
    "react-native-keychain": "^8.1.0",
    "react-native-level-fs": "^3.0.1",
    "react-native-mmkv": "^2.4.1",
    "react-native-paper": "^4.12.1",
    "react-native-permissions": "^3.3.1",
    "react-native-randombytes": "^3.6.1",
    "react-native-safe-area-context": "^4.3.1",
    "react-native-screens": "^3.13.1",
    "react-native-vector-icons": "^9.2.0",
    "readable-stream": "^1.0.33",
    "recoil": "^0.7.4",
    "rn-nodeify": "^10.3.0",
    "stream-browserify": "^1.0.0",
    "util": "^0.12.4",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@babel/core": "^7.12.9",
    "@babel/runtime": "^7.12.5",
    "@react-native-community/eslint-config": "^2.0.0",
    "@storybook/addon-actions": "^5.3",
    "@storybook/addon-knobs": "^5.3",
    "@storybook/addon-links": "^5.3",
    "@storybook/addon-ondevice-actions": "^5.3.23",
    "@storybook/addon-ondevice-knobs": "^5.3.25",
    "@storybook/react-native": "^5.3.25",
    "@testing-library/jest-native": "^4.0.5",
    "@testing-library/react-native": "^10.1.0",
    "@types/big.js": "^6.1.4",
    "@types/jest": "^26.0.23",
    "@types/numeral": "^2.0.2",
    "@types/react-native": "^0.69.0",
    "@types/react-test-renderer": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.29.0",
    "@typescript-eslint/parser": "^5.29.0",
    "babel-jest": "^26.6.3",
    "babel-loader": "^8.2.5",
    "babel-plugin-module-resolver": "^4.1.0",
    "eslint": "^7.32.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-recommended": "^4.1.0",
    "eslint-config-typescript": "^3.0.0",
    "eslint-import-resolver-typescript": "^2.7.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.30.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.0.0",
    "husky": ">=6",
    "jest": "^26.6.3",
    "lint-staged": ">=10",
    "metro-react-native-babel-preset": "^0.70.3",
    "react-dom": "18.0.0",
    "react-native-storybook-loader": "^2.0.5",
    "react-test-renderer": "18.0.0",
    "typescript": "^4.4.4"
  },
  "resolutions": {
    "@types/react": "^18"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testEnvironment": "jsdom",
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native-community|@react-native|@react-navigation)"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect",
      "<rootDir>/jest/setupAfterEnv.js",
      "<rootDir>/jest/globalMock.js"
    ],
    "setupFiles": [
      "<rootDir>/jest/setup.js"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --cache --quiet"
  },
  "config": {
    "react-native-storybook-loader": {
      "searchDir": [
        "./src"
      ],
      "pattern": "**/*.stories.tsx",
      "outputFile": "./storybook/storyLoader.js"
    }
  },
  "License": "Apache-2.0",
  "react-native": {
    "crypto": "react-native-crypto",
    "path": "path-browserify",
    "fs": "react-native-level-fs",
    "_stream_transform": "readable-stream/transform",
    "_stream_readable": "readable-stream/readable",
    "_stream_writable": "readable-stream/writable",
    "_stream_duplex": "readable-stream/duplex",
    "_stream_passthrough": "readable-stream/passthrough",
    "stream": "stream-browserify"
  },
  "browser": {
    "crypto": "react-native-crypto",
    "path": "path-browserify",
    "fs": "react-native-level-fs",
    "_stream_transform": "readable-stream/transform",
    "_stream_readable": "readable-stream/readable",
    "_stream_writable": "readable-stream/writable",
    "_stream_duplex": "readable-stream/duplex",
    "_stream_passthrough": "readable-stream/passthrough",
    "stream": "stream-browserify"
  }
}
