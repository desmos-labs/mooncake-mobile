{
  "name": "butter",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "export VERSION_OVERRIDE=8.5.2 && react-native run-android",
    "ios": "export VERSION_OVERRIDE=8.5.2 && react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "prestorybook": "rnstl",
    "use:main": "cp index.main.js index.js",
    "use:storybook": "cp index.storybook.js index.js && yarn prestorybook",
    "postinstall": "patch-package && rn-nodeify --install stream,crypto,fs,path --hack",
    "deploy:androidInternal": "fastlane android deploy_to_internal_testing",
    "deploy:iosInternal": "fastlane ios closed_beta",
    "deploy:copyDevEnv": "cp .env.dev.sample .env"
  },
